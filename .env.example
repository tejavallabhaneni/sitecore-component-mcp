# SitecoreAI Deploy → Credentials → Environment →
# Create credentials → Automation
SITECORE_CLIENT_ID=
SITECORE_CLIENT_SECRET=

# SitecoreAI Deploy → Projects → [project] →
# Authoring environments → Details → Environment host name
SITECORE_ENV_HOST=your-environment.sitecorecloud.io

# Absolute or relative path to your JSS components folder.
# The sample component in ./example lets you try the extractor without a JSS app.
JSS_COMPONENTS_PATH=./example/src/components

# Shared secret for the /api/mcp route
MCP_SHARED_SECRET=

# Safety: refuse to write unless this is explicitly "true"
ALLOW_PRODUCTION_WRITES=false
